# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
# Optional for fast guild-only command registration in dev
DISCORD_GUILD_ID=

# Lavalink
LAVALINK_NAME=MainNode
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=IT

# Music
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
AUTO_DISCONNECT_MS=120000

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Optional public URL used in Discord embed "Dashboard" button
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3000
