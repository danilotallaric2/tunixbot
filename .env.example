# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
# Optional for fast guild-only command registration in dev
DISCORD_GUILD_ID=

# Lavalink
LAVALINK_NAME=MainNode
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_RECONNECT_TRIES=999999
LAVALINK_RECONNECT_INTERVAL_MS=5000
LAVALINK_RESUME=true
LAVALINK_RESUME_TIMEOUT_SEC=120
LAVALINK_RESUME_BY_LIBRARY=true

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=IT
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_SCOPES=user-read-private user-read-email playlist-read-private playlist-read-collaborative user-library-read
# Comma or space-separated Discord user IDs allowed to see Spotify user library section in dashboard
SPOTIFY_DASHBOARD_ALLOWED_DISCORD_IDS=
# Optional custom path for dashboard Spotify user tokens
SPOTIFY_DASHBOARD_USERS_FILE=src/data/spotify-users.json

# Music
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
AUTO_DISCONNECT_MS=120000
AUTO_PLAY_RELATED_WHEN_QUEUE_ENDS=true
MUSIC_SESSION_PERSISTENCE_ENABLED=true
MUSIC_SESSION_PERSISTENCE_FILE=src/data/music-sessions.json
MUSIC_SESSION_PERSISTENCE_DEBOUNCE_MS=450
MUSIC_SESSION_RESTORE_ON_START=true
MUSIC_SESSION_RESTORE_MAX_AGE_MS=28800000

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=change_this_to_a_long_random_secret
# Optional public URL used in Discord embed "Dashboard" button
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3000

# Guild lifecycle notifications
GUILD_JOIN_LOG_CHANNEL_ID=1235541924547661854
GUILD_LEAVE_LOG_CHANNEL_ID=1235541940901249074
